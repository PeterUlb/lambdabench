 #[tokio::main]
 async fn main() {
+    // Tuning probe: SF_PREFAULT=1 reads the executable once so its pages are
+    // in the page cache before the rest of init runs.
+    if std::env::var("SF_PREFAULT").as_deref() == Ok("1") {
+        if let Ok(mut exe) = std::fs::File::open("/proc/self/exe") {
+            let _ = std::io::copy(&mut exe, &mut std::io::sink());
+        }
+    }
     // Init phase: resolve config once, build all three clients into shared state.
     // Retries disabled: a throttle/transient must surface as a hard failure, not
     // be silently retried into an inflated Duration.
@@ -163,6 +170,29 @@
         receipt_key: std::env::var(ENV_RECEIPT_KEY).expect("LAMBDABENCH_RECEIPT_KEY not set"),
     });
 
+    // Tuning probe: SF_PREWARM=1 makes one real, side-effect-free call per
+    // client at init, concurrently, so DNS, the TLS handshakes and the code
+    // they touch run in Init instead of the first request.
+    if std::env::var("SF_PREWARM").as_deref() == Ok("1") {
+        let s = &state;
+        let (kms, ddb, _s3) = tokio::join!(
+            s.kms
+                .encrypt()
+                .key_id(&s.kms_key_id)
+                .plaintext(aws_sdk_kms::primitives::Blob::new(b"prewarm".to_vec()))
+                .send(),
+            s.ddb
+                .get_item()
+                .table_name(&s.table)
+                .key("pk", AttributeValue::S(s.order_pk.clone()))
+                .send(),
+            // 404 when no receipt exists yet; the connection is still open.
+            s.s3.head_object().bucket(&s.bucket).key(&s.receipt_key).send(),
+        );
+        kms.expect("prewarm KMS");
+        ddb.expect("prewarm DynamoDB");
+    }
+
     let config = CoffeeShopConfig::builder()
         .layer(AddExtensionLayer::new(state))
         .build();
